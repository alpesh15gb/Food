# =============================================================================
# Cloud Kitchen Platform — Environment Configuration
# =============================================================================

# Node environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cloudkitchen

# Authentication
JWT_SECRET=change-this-to-a-random-64-char-string
COOKIE_SECRET=change-this-to-a-random-64-char-string
APP_ID=cloudkitchen-direct
OWNER_OPEN_ID=your-admin-openid

# OAuth (optional — for hosted auth provider)
OAUTH_SERVER_URL=

# VPS Local Admin (for development/testing)
LOCAL_ADMIN_TOKEN=your-admin-passphrase-at-least-16-chars

# Storage (S3-compatible)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Secret Encryption Key (for integration secrets vault)
# Generate with: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=your-64-char-hex-key

# Customer OTP Authentication
# HMAC secret for OTP code hashing — NEVER store in database
# Generate with: openssl rand -hex 32
OTP_HMAC_SECRET=change-this-to-a-random-64-char-string
# Set to "true" ONLY in local development to see OTP codes in console
# MUST be false/absent in staging and production
OTP_DEV_LOG_ENABLED=false

# Asset base URL
ASSET_BASE_URL=/assets

# Platform brand domain (landing + signup). Empty = single-restaurant mode.
PLATFORM_DOMAIN=munchpro.in
FEATURED_STOREFRONT_NAME=9House Kitchen
FEATURED_STOREFRONT_URL=https://9housekitchen.in/
TRUSTED_PROXY=1

# Public base URL (used for order tracking links in notifications)
PUBLIC_URL=http://localhost:3000

# Business timezone
BUSINESS_TIMEZONE=Asia/Kolkata

# Default delivery radius (km)
DEFAULT_DELIVERY_RADIUS_KM=5

# Notifications (optional — WhatsApp Cloud API primary, MSG91 SMS fallback)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MSG91_AUTH_KEY=

# Custom-domain CNAME target (shown in admin DNS instructions)
DOMAIN_CNAME_TARGET=cname.yourdomain.com

# Razorpay (Payment Provider)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Shadowfax (Delivery Provider — Unified API, Forward Integration spec)
# Token auth: ONLY SHADOWFAX_TOKEN is required (provided by Shadowfax).
# Do NOT invent SHADOWFAX_MERCHANT_ID / SHADOWFAX_CLIENT_CODE — not required.
# Webhook secret is OUR OWN optional callback secret (never reuse the token).
# Dispatch stays OFF until Shadowfax confirms this API/account is valid for
# restaurant-to-customer deliveries (see server/integrations/shadowfax.ts).
SHADOWFAX_ENABLED=false
SHADOWFAX_TOKEN=
SHADOWFAX_API_BASE_URL=https://dale.shadowfax.in/api
SHADOWFAX_ENVIRONMENT=production
SHADOWFAX_WEBHOOK_SECRET=
# When to create the Shadowfax shipment: RESTAURANT_ACCEPTED or READY_FOR_PICKUP
DELIVERY_DISPATCH_TRIGGER=READY_FOR_PICKUP
# Staging base URL (set SHADOWFAX_API_BASE_URL to this for staging tests):
# https://dale.staging.shadowfax.in/api
