# =============================================================================
# Cloud Kitchen Platform — Docker Deployment Configuration
# Copy this to deploy/config.env and fill in real values
# Single source: keep in sync with server/_core/env.ts + .env.example
# =============================================================================

# PostgreSQL
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# App identity
APP_ID=cloudkitchen-direct
OWNER_OPEN_ID=your-admin-openid
PUBLIC_URL=https://9housekitchen.in
ASSET_BASE_URL=/assets

# OAuth (optional — for hosted auth provider)
OAUTH_SERVER_URL=

# Storage (S3-compatible)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Google Maps client key (REQUIRED for map pin + place search).
# Create in Google Cloud Console with Maps JavaScript API + Places API +
# Geocoding API enabled, restricted by HTTP referrer to your domains.
# Served to the browser at runtime via /api/maps-config — rotation needs
# only a container restart, never a rebuild.
GOOGLE_MAPS_API_KEY=

# Platform brand domain (landing + signup). Empty = single-restaurant mode.
PLATFORM_DOMAIN=munchpro.in
FEATURED_STOREFRONT_NAME=9House Kitchen
FEATURED_STOREFRONT_URL=https://9housekitchen.in/

# Trust Nginx X-Forwarded-For for real client IPs in rate limits (VPS behind proxy).
TRUSTED_PROXY=1

# Authentication
JWT_SECRET=replace-with-a-64-char-random-string
COOKIE_SECRET=replace-with-a-different-64-char-random-string
LOCAL_ADMIN_TOKEN=replace-with-at-least-10-char-admin-passphrase
SECRET_ENCRYPTION_KEY=replace-with-a-64-char-hex-key
# Bearer fallback for iframe/private browsers where cookies are blocked
# (the web client forwards the session as Authorization: Bearer). Keep 1
# unless you have verified all operators use cookie-capable browsers.
ALLOW_BEARER_AUTH=1

# Customer OTP Authentication
OTP_HMAC_SECRET=replace-with-a-64-char-hex-string
OTP_DEV_LOG_ENABLED=false

# WhatsApp-INBOUND OTP capture (self-hosted Evolution API, Baileys).
# Webhook secret authenticates Evolution callbacks — generate with:
# openssl rand -hex 24. Debug logging MUST stay false in production.
EVOLUTION_API_URL=http://82.112.236.81:8084
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=whatsapp-main
WHATSAPP_WEBHOOK_SECRET=replace-with-a-random-string
EVOLUTION_DEBUG_LOG_ENABLED=false

# Business defaults
BUSINESS_TIMEZONE=Asia/Kolkata
DEFAULT_DELIVERY_RADIUS_KM=5

# Razorpay (activate after merchant account is ready)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shadowfax Unified API (activate after merchant registration)
# Token auth: ONLY SHADOWFAX_TOKEN is required. There is deliberately NO
# SHADOWFAX_API_KEY / SHADOWFAX_MERCHANT_ID — the app never reads them.
# Staging tests: SHADOWFAX_ENVIRONMENT=staging (or set SHADOWFAX_API_BASE_URL
# to https://dale.staging.shadowfax.in/api). Keep ENABLED=false until
# Shadowfax confirms the account is valid for restaurant deliveries.
SHADOWFAX_ENABLED=false
SHADOWFAX_TOKEN=
# Leave empty so SHADOWFAX_ENVIRONMENT decides (staging vs production).
# Set explicitly only to pin one host, e.g. staging tests:
# SHADOWFAX_API_BASE_URL=https://dale.staging.shadowfax.in/api
SHADOWFAX_API_BASE_URL=
SHADOWFAX_ENVIRONMENT=production
SHADOWFAX_WEBHOOK_SECRET=
# When to create the shipment: RESTAURANT_ACCEPTED or READY_FOR_PICKUP
DELIVERY_DISPATCH_TRIGGER=READY_FOR_PICKUP

# Notifications (optional — WhatsApp Cloud API primary, MSG91 SMS fallback)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MSG91_AUTH_KEY=

# Custom domain CNAME target (used for domain verification)
DOMAIN_CNAME_TARGET=cname.yourdomain.com
