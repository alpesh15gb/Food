# Supply these as root-only runtime variables during a controlled VPS deployment.
MYSQL_PASSWORD=replace-with-a-long-random-value
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-value
JWT_SECRET=replace-with-a-long-random-value
LOCAL_ADMIN_TOKEN=replace-with-a-long-random-administrator-passphrase
SECRET_ENCRYPTION_KEY=replace-with-a-64-character-hexadecimal-key
# Add these after activating live payment:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
